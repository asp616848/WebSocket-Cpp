# Define common compiler flags
config("default_compiler_flags") {
  cflags = [
    "-Wall",
    "-Wextra",
    "-pedantic",
    "-std=c++17",
  ]
  include_dirs = [ "//include", "//src" ]
}

# Define debug configuration
config("debug") {
  cflags = [ "-g", "-O0" ]
  defines = [ "DEBUG" ]
}

# Define release configuration
config("release") {
  cflags = [ "-O3" ]
  defines = [ "NDEBUG" ]
}

# WebSocket library target
static_library("websocket") {
  sources = [
    "src/WebSocket.cpp",
    "src/WebSocketConnect.cpp",
    "include/WebSocket.h",
  ]
  include_dirs = [ "include" ]
  libs = [
    "boost_system",
    "ssl",
    "crypto"
  ]
}

# WebSocketClient library target
static_library("websocket_client_lib") {
  sources = [
    "src/WebSocketClient.cpp",
    "include/WebSocketClient.h",
  ]
  include_dirs = [ "include" ]
  deps = [ ":websocket" ]
}

# File Handler library target
static_library("file_handler") {
  sources = [
    "src/FileHandler.cpp",
    "include/FileHandler.h",
  ]
  include_dirs = [ "include" ]
}

# String Utils library target
static_library("string_utils") {
  sources = [
    "src/StringUtils.cpp",
    "include/StringUtils.h",
  ]
  include_dirs = [ "include" ]
}

# CLI library target
static_library("cli") {
  sources = [
    "src/CLI.cpp",
    "include/CLI.h",
  ]
  include_dirs = [ "include" ]
}

# Main executable target
executable("websocket_client") {
  sources = [ "src/main.cpp" ]
  include_dirs = [ "include" ]
  deps = [
    ":websocket",
    ":websocket_client_lib",
    ":cli",
    ":file_handler",
    ":string_utils",
  ]
  libs = [
    "boost_system",
    "ssl",
    "crypto"
  ]
}

# Test executable target
executable("websocket_test") {
  sources = [ "tests/WebSocketTest.cpp" ]
  deps = [ ":websocket" ]
  
  # Add test framework
  libs = [ "gtest", "gtest_main", "pthread" ]
  
  if (is_debug) {
    configs += [ ":debug" ]
  } else {
    configs += [ ":release" ]
  }
}

# Group target for all builds
group("all") {
  deps = [
    ":websocket_client",
    ":websocket_test",
  ]
}
