include_dirs = -I../../../include -I../../../src
cflags = -Wall -Wextra -pedantic -std=c++17
cflags_cc =
target_out_dir = obj
target_output_name = websocket

build obj/src/websocket.WebSocket.o: cxx ../../../src/WebSocket.cpp
  source_file_part = WebSocket.cpp
  source_name_part = WebSocket
build obj/src/websocket.WebSocketConnect.o: cxx ../../../src/WebSocketConnect.cpp
  source_file_part = WebSocketConnect.cpp
  source_name_part = WebSocketConnect
build obj/src/websocket.WebSocketClient.o: cxx ../../../src/WebSocketClient.cpp
  source_file_part = WebSocketClient.cpp
  source_name_part = WebSocketClient

build obj/websocket.a: alink obj/src/websocket.WebSocket.o obj/src/websocket.WebSocketConnect.o obj/src/websocket.WebSocketClient.o
  arflags =
  output_extension = .a
  output_dir = 
